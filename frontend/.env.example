# Local API requests are proxied to http://localhost:4000 by Vite.
# For an independent deployment, use your own backend origin.
VITE_API_BASE_URL=/api

# Optional override for the eVerify Web SDK capture path.
# Normally the backend's VERIFICATION_METHOD selects the provider through /auth/config.
# See docs/configuration.md for live identity verification setup.
VITE_EVERIFY_SDK_ENABLED=false
# Optional public-key fallback when /auth/config does not supply EVERIFY_PUBKEY.
# This value is included in the browser bundle. Never enter a client secret here.
VITE_EVERIFY_PUBKEY=
