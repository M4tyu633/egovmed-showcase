# The backend base URL the app talks to.
# In dev, leave this as /api — vite.config.js proxies /api → the backend (VITE_API_PROXY, default http://localhost:4000).
# In production, set the deployed backend origin (e.g. https://api.example.org).
VITE_API_BASE_URL=/api

# eVerify Face Liveness Web SDK (window.eKYC().start({ pubKey })). Off by default — the app uses
# our own Face Liveness hosted-redirect flow instead. Flip to 'true' to test the SDK flow, which
# is what backend EVERIFY_MODE=live actually requires (see README "Known integration gotcha").
VITE_EVERIFY_SDK_ENABLED=false
# OPTIONAL fallback. The app normally reads the pubKey from the backend's GET /auth/config, which
# serves the backend's own EVERIFY_PUBKEY — one place to set it, and rotating it needs no frontend
# rebuild (this var is baked into the bundle at build time). Only set this when pointing at a
# backend that has no EVERIFY_PUBKEY. The eVerify portal calls it a "Public API Key" — safe to ship
# to the browser, unlike EVERIFY_CLIENT_SECRET. From https://platforms.e.gov.ph/ → eVerify.
VITE_EVERIFY_PUBKEY=
