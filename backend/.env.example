# ─────────────────────────────────────────────────────────────
# eGovMed backend — environment configuration
# Copy to .env for local dev. Set the same keys in Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000                 # frontend origin (CORS + SSO redirect target)
API_PUBLIC_URL=http://localhost:4000          # this backend's public URL (used to build SSO callback)

# Security (GENERATE YOUR OWN — see README)
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL=86400                             # session lifetime in seconds
PHI_ENCRYPTION_KEY=change-me-32-byte-hex      # 64 hex chars = 32 bytes, for AES-256-GCM (REQUIRED in production)
ADMIN_KEY=                                    # x-admin-key header for operational routes (report escalation sweep, recurring-issue insights, audit log sweep)
ALLOW_MOCK_IN_PRODUCTION=false                # emergency/demo escape hatch; never enable for a live citizen deployment
AUDIT_LOG_RETENTION_DAYS=180                  # POST /integrations/audit/sweep (ADMIN/cron) evicts PHI-access audit entries older than this

# Persistence.  memory = in-process (local only); kv = Upstash Redis (recommended on Vercel)
STORE_DRIVER=memory
# Namespaces every Redis key so a non-production deployment can share production's Upstash
# database without colliding. Leave EMPTY for production and local dev. Staging sets "staging".
# Guarded at boot: a prefix in production, or no prefix on a Vercel preview using kv, is fatal.
STORE_KEY_PREFIX=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Global integration switch. Each integration can override with its own *_MODE.
#   live = call the real eGov API   |   mock = return realistic fake data (demo/offline)
INTEGRATION_MODE=mock

# 1) eGovPH  (SSO / auth) ─ exchange-code flow (POST {BASE}/api/token → /api/partner/sso_authentication)
EGOVPH_MODE=
EGOVPH_BASE_URL=https://platforms-api.e.gov.ph/egov-sso
EGOVPH_PARTNER_CODE=                          # from the eGov admin
EGOVPH_PARTNER_SECRET=                        # from the eGov admin
EGOVPH_SCOPE=SSO_AUTHENTICATION
EGOVPH_LAUNCH_URL=                           # optional eGov app/portal launch URL; callback is {APP_URL}/egovph/sso

# 2) eGov AI  (triage engine) ─ POST /api/v1/egov/integration/token (access_code) → Bearer, then /ai_assistant/generate
EGOV_AI_MODE=
EGOV_AI_BASE_URL=https://platforms-api.e.gov.ph/egov-ai   # gateway base from the eGov developer portal
EGOV_AI_ACCESS_CODE=                           # team hackathon access code
EGOV_AI_CATEGORY=PH

# 3) National ID eVerify  (NIDAS) ─ POST /api/auth (client creds) → POST /api/query (demographics + liveness)
EVERIFY_MODE=
EVERIFY_BASE_URL=https://platforms-api.e.gov.ph/everify
EVERIFY_CLIENT_ID=                             # credential: client-id
EVERIFY_CLIENT_SECRET=                         # credential: client-secret
EVERIFY_PUBKEY=                                # credential: pubkey (eVerify liveness widget; optional)

# 4) Face Liveness ─ hosted service (POST /v1/liveness/session → GET /v1/liveness/result/{token}, x-api-key)
FACE_LIVENESS_MODE=
FACE_LIVENESS_BASE_URL=https://platforms-api.e.gov.ph/face-liveness
FACE_LIVENESS_API_KEY=
FACE_LIVENESS_ACTION=redirect
FACE_LIVENESS_CALLBACK_URL=                  # defaults to {APP_URL}/liveness/callback
FACE_LIVENESS_MIN_CONFIDENCE=95

# Demo affordance. eGovPH's sandbox SSO personas come back with +63909000000N numbers that no
# carrier will deliver to, so on a demo deployment every SMS the app sends vanishes. Set this to
# one real handset and every notification for a patient who has NOT set their own number in
# Account goes there instead: appointment confirmations, reminders, report-filing OTPs, and the
# complainant contact eReport files with a case. A number the patient types in Account always
# wins over this. Leave it EMPTY for a real deployment — the backend warns at boot if it is set.
# E.164 only: +63 followed by 10 digits.
NOTIFY_DEFAULT_PHONE=

# 5) eMessage  (SMS) ─ POST /messaging/v1/sms/push, X-EMESSAGE-Auth header
EMESSAGE_MODE=
EMESSAGE_BASE_URL=https://platforms-api.e.gov.ph/emessage
EMESSAGE_AUTH_TOKEN=                            # credential: access-token (sent as the X-EMESSAGE-Auth header)
EMESSAGE_SENDER_ID=eGovMed

# 6) eGovChain  (Hyperledger Besu QBFT, zero-fee JSON-RPC anchoring)
EGOVCHAIN_MODE=
EGOVCHAIN_RPC_URL=                              # https://platforms-api.e.gov.ph/egovchain/{your-token}; private, required in live mode
EGOVCHAIN_CHAIN_ID=13371
EGOVCHAIN_PRIVATE_KEY=                         # signer key (zero-fee chain, no gas funding needed)

# 7) eGovPay  (unified payment gateway) ─ POST /api/v1/transaction with X-eGovPay-Token + HMAC digest
EGOVPAY_MODE=
EGOVPAY_BASE_URL=https://platforms-api.e.gov.ph/egovpay
EGOVPAY_TOKEN=                                 # credential: api-key (sent as X-eGovPay-Token; test_-prefixed = test mode)
EGOVPAY_SETTLEMENT_TEMPLATE_UUID=              # credential: settlement-template-uuid
EGOVPAY_REDIRECT_URL=                        # defaults to {APP_URL}/payment/return
EGOVPAY_CALLBACK_URL=                        # defaults to {API_PUBLIC_URL}/payments/callback
EGOVPAY_MOCK_OUTCOME=                          # mock mode only: force a status (paid|failed|voided|cancelled|declined) to test that UI path; defaults to paid

# 8) eReport  (issue tracking) ─ POST /api/integration/token (access_code) → submit_complaint.
# No EREPORT_VIEW_TOKEN: report lookup needs a per-complainant OTP-minted token, so eGovMed does
# not read back government-side status. See docs/integrations.md.
EREPORT_MODE=
EREPORT_BASE_URL=                              # per-env base
EREPORT_ACCESS_CODE=                           # credential: access-token (used as the token-endpoint access_code)
EREPORT_TYPE=red_tape                          # eReport report_type enum used for filed complaints
EREPORT_REGION_CODE=130000000                  # NATIONAL CAPITAL REGION (NCR)
EREPORT_PROVINCE_CODE=133900000                # CITY OF MANILA
EREPORT_MUNICIPALITY_CODE=133908000            # ERMITA (Manila districts are "municipalities" in this dataset)
EREPORT_BARANGAY_CODE=133908012                # Barangay 670 — best available match for PGH, see docs/integrations.md
EREPORT_ESCALATE_AFTER_HOURS=48
